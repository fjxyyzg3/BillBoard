# Copy to .env.android.local. Keep real addresses and signing material private.
JAVA_HOME=C:/path/to/jdk-17
ANDROID_HOME=C:/path/to/android-sdk
BILLBOARD_ANDROID_ORIGIN=https://<private-host>
BILLBOARD_ANDROID_KEYSTORE=C:/private/billboard-release.p12
BILLBOARD_ANDROID_KEY_ALIAS=billboard-release
BILLBOARD_ANDROID_STORE_PASSWORD=<private-signing-password>
BILLBOARD_ANDROID_KEY_PASSWORD=<private-signing-password>
